# Copy to .env and fill in real values. Never commit .env to version control.
# Flask session signing key — REQUIRED for production. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection. Default (SQLite): sqlite:///learning_portal.db
# Postgres example: postgresql://user:pass@localhost:5432/learning_portal
DATABASE_URL=sqlite:///learning_portal.db

# Server binding (used by run.py and serve.py)
HOST=0.0.0.0
PORT=5000

# Optional shared-password gate for private previews.
# When set, every visitor must enter this password once per browser session.
# Leave empty (or remove) to disable the gate entirely (e.g. local dev).
SITE_PASSWORD=